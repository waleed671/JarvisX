# ── Chrome path (Windows default) ────────────────────────────────────────────
JARVIS_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ── n8n Router — internet research (news, crypto, stocks, songs, Wikipedia) ──
# Import n8n/jarvis-router.workflow.json into n8n and activate it.
JARVIS_N8N_ROUTER_WEBHOOK_URL=http://localhost:5678/webhook/jarvis-router

# ── n8n WhatsApp auto-send ─────────────────────────────────────────────────
# Import n8n/jarvis-whatsapp.workflow.json into n8n.
# Requires Twilio credentials set as n8n env vars (TWILIO_ACCOUNT_SID, etc.)
# Leave empty to use WhatsApp Web draft fallback.
JARVIS_WHATSAPP_WEBHOOK_URL=http://localhost:5678/webhook/jarvis-whatsapp

# ── n8n Email auto-send ────────────────────────────────────────────────────
# Import n8n/jarvis-email.workflow.json into n8n.
# Requires Gmail OAuth2 credential configured in n8n.
# Leave empty to use Gmail compose draft fallback.
JARVIS_EMAIL_WEBHOOK_URL=http://localhost:5678/webhook/jarvis-email

# ── Optional: direct OpenAI answers (fallback if n8n router is offline) ──────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── n8n Docker callback URL (used when n8n needs to call JarvisX) ─────────────
JARVIS_LOCAL_CALLBACK_URL=http://host.docker.internal:8000
